# Production settings for glowthdot.com.
# On the server: copy to .env, fill in every value marked FILL, then run `php artisan key:generate`.

APP_NAME=Glowth
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://glowthdot.com
CANONICAL_URL=https://glowthdot.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# The site needs no database: pages are files, routes skip sessions, the form rate limit uses the file cache
DB_CONNECTION=sqlite
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# SMTP: the same values as GLOWTH_SMTP_* in the old wp-config.php
MAIL_MAILER=smtp
MAIL_HOST=mail.glowthdot.com
MAIL_PORT=465
# smtps for port 465; leave empty for 587 (STARTTLS)
MAIL_SCHEME=smtps
MAIL_USERNAME=sales@glowthdot.com
# The sales@glowthdot.com mailbox password (cPanel > Email Accounts)
MAIL_PASSWORD=FILL
MAIL_FROM_ADDRESS="sales@glowthdot.com"
MAIL_FROM_NAME="Glowth"

# Website enquiries (always saved in storage/app/private/leads as well)
LEADS_EMAIL=sales@glowthdot.com
LEADS_REPLY_TO=sales@glowthdot.com
# Kept out of git: anyone with this URL can add rows. Copy it from the local .env.
LEADS_SHEET_URL=FILL

# MCP server for the claude.ai connector (routes/ai.php): a random secret, at least 32 characters.
# Make one with: php -r "echo bin2hex(random_bytes(32));"
MCP_SECRET=

# Optional: the clear_cache tool also purges Cloudflare when both are set
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=
